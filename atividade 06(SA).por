programa {
  funcao inicio() {
     inteiro anonascimento, anoatual, idade
     escreva("Digite o ano de nascimento: ")
     leia(anonascimento)
     escreva("Digite o ano atual: ")
     leia(anoatual)
     idade = anoatual - anonascimento
     se (idade >=18)
      escreva("Pode ser contratado")
      senao
      escreva("Não pode ser contratado")
     
  }
}
