programa {
  funcao inicio() {
    inteiro codigo
    escreva("1 - Financeiro", "\n")
    escreva("2 - TI", "\n")
    escreva("3 - Marketing", "\n")
    escreva("4 - Operações", "\n")
    escreva("Digite o código: ")
    leia(codigo)
    escolha (codigo){
      caso 1:
      escreva("Financeiro")
      pare
      caso 2:
      escreva("TI")
      pare
      caso 3:
      escreva("Marketing")
      pare
      escreva("Operações")
    }

  }
}
