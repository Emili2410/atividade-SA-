programa {
  funcao inicio() {
    inteiro senha
    cadeia usuario
    senha=24102007
    usuario=("Emilia")
    escreva("Digite o usuário: ")
    leia(usuario)
    escreva("Digite a senha: ")
    leia(senha)
    se((usuario!=("Emilia")) ou (senha!=24102007))
    escreva("Usuário ou senha inválidos. ")
    senao
    escreva("Login bem-sucedido. ")
  }
}
