programa {
  funcao inicio() {
    inteiro codigo
    escreva("1 - Cachorro Quente", "\n")
    escreva("2 - Hambúrguer", "\n")
    escreva("3 - Suco")
    escreva("4 - Refrigerante", "\n")
    escreva("Digite o código do produto: ")
    leia(codigo)
    escolha (codigo){
    caso 1:
    escreva("Cachorro Quente - R$ 8,00")
    pare
    caso 2: 
    escreva("Hambúrguer - R$ 10,00")
    pare
    caso 3:
    escreva("Suco - R$ 6,00")
    pare
    caso 4:
    escreva("Refrigerante - R$ 5,00")
    }
  }
}
